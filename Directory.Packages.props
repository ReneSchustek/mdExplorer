<Project>
  <!--
    Fassungen aller NuGet-Pakete an einer Stelle. Die Projektdateien nennen nur noch den
    Paketnamen; ein Paket, das mehrere Projekte nutzen, kann so nicht in verschiedenen
    Fassungen auseinanderlaufen.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Laufzeitstapel bewusst auf der 10er-Reihe: EF Core 11 verlangt .NET 11, das Projekt zielt auf
    .NET 10. Microsoft.Extensions 11, Serilog.Extensions.Hosting 11 und TimeProvider.Testing 11
    liefen zwar auf .NET 10, zögen aber die 11er-Abstraktionen unter die 10er-Fassung von EF Core.
    Alle zusammen wechseln mit dem Umzug auf .NET 11 (Stand 24.11.2026).
  -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.37.0.15768" />
    <!-- Über der Fassung, die Microsoft.Data.Sqlite nachzieht (2.1er-Reihe); in 2.1.11 stand
         GHSA-2m69-gcr7-jv3q (Schweregrad High). Beim Anheben von Microsoft.Data.Sqlite
         prüfen, ob der Eintrag noch nötig ist. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Die Variante ohne Microsoft Testing Platform: Die Tests laufen weiter über VSTest, damit
         coverlet.collector, tests.runsettings und der Testaufruf des Gates unverändert gelten.
         Das Standardpaket xunit.v3 startet ab 4.0 über die neue Plattform, und das .NET-10-SDK
         verweigert dann den gewohnten Aufruf von dotnet test. -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
