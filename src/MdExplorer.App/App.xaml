<Application x:Class="MdExplorer.App.App"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Reihenfolge: erst die theme-unabhängigen Bausteine, dann die Belegung.
                    Die Belegung wird beim Start gegen die gewählte getauscht; hier steht
                    die helle, damit der Entwurf im Fenster-Vorschaufenster etwas anzeigt.
                -->
                <ResourceDictionary Source="/Themes/Tokens.xaml" />
                <ResourceDictionary Source="/Themes/Light.xaml" />
                <!--
                    Zuletzt, weil die Styles auf beides zugreifen. Ohne sie nähme jedes
                    Bedienelement ohne eigene Farbe die Voreinstellung des Rahmenwerks —
                    und die halbe Oberfläche bliebe im Dunklen hell.
                -->
                <ResourceDictionary Source="/Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
