<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MdExplorer.App</RootNamespace>
    <AssemblyName>MdExplorer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MdExplorer.Core\MdExplorer.Core.csproj" />
    <ProjectReference Include="..\MdExplorer.Data\MdExplorer.Data.csproj" />
    <ProjectReference Include="..\MdExplorer.Graph\MdExplorer.Graph.csproj" />
    <ProjectReference Include="..\MdExplorer.Indexer\MdExplorer.Indexer.csproj" />
    <ProjectReference Include="..\MdExplorer.Parser\MdExplorer.Parser.csproj" />
    <ProjectReference Include="..\MdExplorer.Presentation\MdExplorer.Presentation.csproj" />
    <ProjectReference Include="..\MdExplorer.Search\MdExplorer.Search.csproj" />
    <ProjectReference Include="..\MdExplorer.TagCloud\MdExplorer.TagCloud.csproj" />
    <ProjectReference Include="..\MdExplorer.Update\MdExplorer.Update.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Logo.png" />
    <!-- Schriften der Gestaltungslinie, mitgeliefert statt vorausgesetzt (OFL-1.1, Lizenztexte
         daneben). WPF liest feste TTF-Schnitte, erzeugt mit tools/schriften-statisch.py; die
         HTML-Seiten bekommen die WOFF2-Dateien als data:-URI über WebFontFaces. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <EmbeddedResource Include="Assets\Fonts\*.woff2" LogicalName="MdExplorer.App.Assets.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\preview.css" />
    <EmbeddedResource Include="Assets\Graph\graph.html" />
    <EmbeddedResource Include="Assets\Graph\graph.css" />
    <EmbeddedResource Include="Assets\Graph\graph.js" />
    <EmbeddedResource Include="Assets\Help\help.html" />
    <EmbeddedResource Include="Assets\Help\help.css" />
    <EmbeddedResource Include="Assets\Help\help.js" />
    <EmbeddedResource Include="..\..\docs\HANDBUCH.md" LogicalName="MdExplorer.App.Assets.Help.Handbuch.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MdExplorer.App.Tests" />
  </ItemGroup>

</Project>
