<UserControl x:Class="MdExplorer.App.Controls.AlphabetJumpBar"
             x:ClassModifier="internal"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MdExplorer.App.Localization">
    <!--
        Sprungleiste der Linie. Sie springt, sie filtert nicht: Ein Klick auf „M" rollt zur
        Gruppe M, der übrige Bestand bleibt sichtbar. Wer filtert, verliert beim Stöbern
        genau den Überblick, den er behalten will.

        Buchstaben ohne Einträge sind deaktiviert, nicht ausgeblendet. Eine Leiste, die ihre
        Breite je nach Bestand ändert, ist kein verlässlicher Anlaufpunkt.
    -->
    <ItemsControl ItemsSource="{Binding Letters, ElementName=Root}"
                  KeyboardNavigation.TabNavigation="Continue"
                  AutomationProperties.Name="{l:Loc AlphabetJumpBar_Name}">
        <!-- Ohne Namen hieße der Eintrag im Automatisierungsbaum nach seinem Datentyp. -->
        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Content="{Binding Label}"
                        Command="{Binding JumpCommand, ElementName=Root}"
                        CommandParameter="{Binding Label}"
                        IsEnabled="{Binding HasEntries}"
                        MinWidth="20"
                        Padding="2,1"
                        Margin="1,0"
                        ToolTip="{Binding Label, StringFormat={l:Loc AlphabetJumpBar_JumpTo}}"
                        AutomationProperties.Name="{Binding Label, StringFormat={l:Loc AlphabetJumpBar_JumpTo}}">
                    <Button.Style>
                        <!-- Die Fläche beim Überfahren bringt die Vorlage der Schaltfläche mit. -->
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Style.Triggers>
                                <!-- Deaktivierte Buchstaben bleiben stehen, treten aber zurück. -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
