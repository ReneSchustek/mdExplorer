<UserControl x:Class="MdExplorer.App.Controls.AlphabetJumpBar"
             x:ClassModifier="internal"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Sprungleiste der Linie. Sie springt, sie filtert nicht: Ein Klick auf „M" rollt zur
        Gruppe M, der übrige Bestand bleibt sichtbar — wer filtert, verliert beim Stöbern
        genau den Überblick, den er behalten will.

        Buchstaben ohne Einträge sind deaktiviert, nicht ausgeblendet. Eine Leiste, die ihre
        Breite je nach Bestand ändert, ist kein verlässlicher Anlaufpunkt.
    -->
    <ItemsControl ItemsSource="{Binding Letters, ElementName=Root}"
                  KeyboardNavigation.TabNavigation="Continue"
                  AutomationProperties.Name="Sprungleiste">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Content="{Binding Label}"
                        Command="{Binding JumpCommand, ElementName=Root}"
                        CommandParameter="{Binding Label}"
                        IsEnabled="{Binding HasEntries}"
                        MinWidth="20"
                        Padding="2,1"
                        Margin="1,0"
                        BorderThickness="0"
                        Background="Transparent"
                        ToolTip="{Binding Label, StringFormat='Zur Gruppe {0} springen'}"
                        AutomationProperties.Name="{Binding Label, StringFormat='Zur Gruppe {0} springen'}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Style.Triggers>
                                <!-- Deaktivierte Buchstaben bleiben stehen, treten aber zurück. -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
