<UserControl x:Class="MdExplorer.App.Controls.SearchBox"
             x:ClassModifier="internal"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Suchfeld der Linie: Lupe links, ein Platzhalter der sagt WAS durchsucht wird,
        rechts ein Löschen-Zeichen, das nur bei gefülltem Feld erscheint. Escape leert.
        Gefiltert wird beim Tippen — eine Suche, die erst auf einen Klick reagiert, fühlt
        sich langsam an, auch wenn sie schnell ist.
    -->
    <Border Background="{DynamicResource InputBackgroundBrush}"
            BorderBrush="{DynamicResource InputBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Padding="6,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="🔍"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Foreground="{DynamicResource TextTertiaryBrush}" />

            <Grid Grid.Column="1">
                <TextBox x:Name="Input"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Padding="0,6"
                         Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding Placeholder, ElementName=Root}"
                         KeyDown="OnInputKeyDown" />

                <!-- Der Platzhalter ist zugleich die Beschriftung für die Sprachausgabe. -->
                <TextBlock IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="2,0,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{Binding Placeholder, ElementName=Root}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=Root}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=Root}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="2"
                    Content="⌫"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4,0"
                    Click="OnClearClick"
                    ToolTip="Suche zurücksetzen (Escape)"
                    AutomationProperties.Name="Suche zurücksetzen">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Root}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
