<!--
    Theme-unabhängige Bausteine: Abstände, Radien, Typografie.

    Diese Werte gelten in Hell und Dunkel gleichermaßen — nur Farben wechseln mit dem
    Erscheinungsbild. Deshalb stehen sie hier und nicht in Light.xaml/Dark.xaml.
    Ansichten binden sie über StaticResource, weil sie sich zur Laufzeit nie ändern.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- ── Abstände ──────────────────────────────────────────────────────── -->
    <!-- Eine Skala statt frei gewählter Zahlen: gleiche Abstände sehen überall
         gleich aus, und eine Änderung wirkt an einer Stelle. -->
    <system:Double x:Key="SpacingXs">4</system:Double>
    <system:Double x:Key="SpacingS">8</system:Double>
    <system:Double x:Key="SpacingM">16</system:Double>
    <system:Double x:Key="SpacingL">24</system:Double>
    <system:Double x:Key="SpacingXl">32</system:Double>

    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ControlPadding">12,8</Thickness>
    <Thickness x:Key="CompactPadding">8,4</Thickness>
    <Thickness x:Key="StackGapS">0,0,0,8</Thickness>
    <Thickness x:Key="StackGapM">0,0,0,16</Thickness>

    <!-- ── Radien ───────────────────────────────────────────────────────── -->
    <!-- Klein halten: Die Marke ist Industrie, nicht Spielzeug. -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">4</CornerRadius>

    <!-- ── Typografie ───────────────────────────────────────────────────── -->
    <!-- Segoe UI Variable ist ab Windows 11 vorhanden; Segoe UI trägt ältere
         Systeme, ohne dass ein Rückfall auf eine Serifenschrift kippt. -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Für Pfade, Kennungen und Auszeichnungen: dort trägt gleiche Zeichenbreite
         die Lesbarkeit, weil man Stellen untereinander vergleicht. -->
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas</FontFamily>

    <system:Double x:Key="FontSizeCaption">11</system:Double>
    <system:Double x:Key="FontSizeBody">13</system:Double>
    <system:Double x:Key="FontSizeSubtitle">16</system:Double>
    <system:Double x:Key="FontSizeTitle">20</system:Double>
    <system:Double x:Key="FontSizeHeader">28</system:Double>

    <!-- ── Markenfarben ─────────────────────────────────────────────────── -->
    <!--
        Bewusst hier und nicht in den Belegungen: Das Startbild erscheint, bevor das
        gewählte Erscheinungsbild geladen ist, und trägt die Farben des Logos. Diese
        wechseln mit Hell und Dunkel nicht mit.
    -->
    <SolidColorBrush x:Key="BrandPrimaryBrush"   Color="#105776" />
    <SolidColorBrush x:Key="BrandMutedBrush"     Color="#6B7C88" />
    <SolidColorBrush x:Key="BrandSurfaceBrush"   Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrandHairlineBrush"  Color="#E0E0E0" />

    <!-- ── Kanten und Höhen ─────────────────────────────────────────────── -->
    <Thickness x:Key="HairlineBorderThickness">1</Thickness>
    <system:Double x:Key="RowHeightDefault">36</system:Double>
    <system:Double x:Key="SplitterWidth">6</system:Double>
    <system:Double x:Key="IconSizeS">14</system:Double>
    <system:Double x:Key="IconSizeM">18</system:Double>

</ResourceDictionary>
