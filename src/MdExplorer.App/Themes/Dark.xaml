<!--
    Dunkle Belegung der Gestaltungslinie. Denselben Schlüsselsatz wie Light.xaml führen,
    sonst greift beim Wechsel zur Laufzeit eine Bindung ins Leere.

    Die Primärfarbe kippt hier bewusst von Petrol auf Stahlgrau: Auf dunklem Grund braucht
    der Akzent Helligkeit — und der Text auf ihm kippt mit, sonst stünde Weiß auf Hellgrau.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Flächen ──────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="AppBackgroundBrush"      Color="#0F1923" />
    <SolidColorBrush x:Key="SurfaceBrush"            Color="#152030" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush"    Color="#1A2535" />
    <SolidColorBrush x:Key="SurfaceHoverBrush"       Color="#213048" />

    <!-- ── Text ─────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TextPrimaryBrush"        Color="#E4EDF2" />
    <SolidColorBrush x:Key="TextSecondaryBrush"      Color="#8AA3B0" />
    <SolidColorBrush x:Key="TextTertiaryBrush"       Color="#6B8090" />
    <SolidColorBrush x:Key="TextDisabledBrush"       Color="#4A5A68" />

    <!-- Dunkle Schrift auf heller Primärfläche — die Umkehrung von Light.xaml. -->
    <SolidColorBrush x:Key="TextOnAccentBrush"       Color="#0F1923" />

    <!-- ── Akzent (Stahlgrau statt Petrol) ──────────────────────────────── -->
    <SolidColorBrush x:Key="AccentPrimaryBrush"         Color="#C5D0D6" />
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush"    Color="#DDE5E9" />
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush"  Color="#94A3AB" />
    <SolidColorBrush x:Key="AccentPrimaryDisabledBrush" Color="#3A4856" />
    <SolidColorBrush x:Key="AccentSoftBrush"            Color="#94A3AB" />

    <!-- ── Schaltflächen ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush"         Color="#C5D0D6" />
    <SolidColorBrush x:Key="ButtonBackgroundHoverBrush"    Color="#DDE5E9" />
    <SolidColorBrush x:Key="ButtonBackgroundPressedBrush"  Color="#94A3AB" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabledBrush" Color="#243244" />
    <SolidColorBrush x:Key="ButtonForegroundBrush"         Color="#0F1923" />
    <SolidColorBrush x:Key="ButtonForegroundDisabledBrush" Color="#5A6B7A" />

    <SolidColorBrush x:Key="ButtonSecondaryBackgroundBrush"      Color="#152030" />
    <SolidColorBrush x:Key="ButtonSecondaryBackgroundHoverBrush" Color="#213048" />
    <SolidColorBrush x:Key="ButtonSecondaryForegroundBrush"      Color="#E4EDF2" />
    <SolidColorBrush x:Key="ButtonSecondaryBorderBrush"          Color="#2E3E50" />

    <!-- ── Karten und Kacheln ───────────────────────────────────────────── -->
    <SolidColorBrush x:Key="CardBackgroundBrush"      Color="#152030" />
    <SolidColorBrush x:Key="CardBackgroundHoverBrush" Color="#1A2535" />
    <SolidColorBrush x:Key="CardBorderBrush"          Color="#2E3E50" />
    <SolidColorBrush x:Key="CardBorderHoverBrush"     Color="#C5D0D6" />

    <!-- ── Werkzeug- und Statusleiste ───────────────────────────────────── -->
    <SolidColorBrush x:Key="ToolBarBackgroundBrush"   Color="#152030" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#152030" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#8AA3B0" />
    <SolidColorBrush x:Key="StatusBarErrorBrush"      Color="#E4948F" />

    <!-- ── Eingabefelder ────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="InputBackgroundBrush"         Color="#152030" />
    <SolidColorBrush x:Key="InputBackgroundHoverBrush"    Color="#1A2535" />
    <SolidColorBrush x:Key="InputBackgroundFocusBrush"    Color="#1A2535" />
    <SolidColorBrush x:Key="InputBackgroundDisabledBrush" Color="#243244" />
    <SolidColorBrush x:Key="InputBorderBrush"             Color="#6B7C88" />
    <SolidColorBrush x:Key="InputBorderHoverBrush"        Color="#46586B" />
    <SolidColorBrush x:Key="InputBorderFocusBrush"        Color="#C5D0D6" />

    <!-- ── Auswahl, Linien, Fokus ───────────────────────────────────────── -->
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#213048" />
    <SolidColorBrush x:Key="SelectionBorderBrush"     Color="#C5D0D6" />
    <SolidColorBrush x:Key="DividerBrush"             Color="#2E3E50" />
    <SolidColorBrush x:Key="SplitterBrush"            Color="#243244" />
    <SolidColorBrush x:Key="FocusVisualBrush"         Color="#94A3AB" />

    <!-- ── Hinweise ─────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="NoticeWarningBackgroundBrush" Color="#33290F" />
    <SolidColorBrush x:Key="NoticeWarningBorderBrush"     Color="#6B551F" />
    <SolidColorBrush x:Key="NoticeWarningForegroundBrush" Color="#E8C77A" />

    <SolidColorBrush x:Key="NoticeInfoBackgroundBrush"    Color="#152A3F" />
    <SolidColorBrush x:Key="NoticeInfoBorderBrush"        Color="#2C4A73" />
    <SolidColorBrush x:Key="NoticeInfoForegroundBrush"    Color="#A8C5F0" />

    <!-- ── Zustände (Protokoll, Indizierung) ────────────────────────────── -->
    <SolidColorBrush x:Key="StateSuccessBrush" Color="#8FD5A3" />
    <SolidColorBrush x:Key="StateWarningBrush" Color="#E8C77A" />
    <SolidColorBrush x:Key="StateErrorBrush"   Color="#E4948F" />
    <SolidColorBrush x:Key="StateNeutralBrush" Color="#C5D0D6" />

    <!-- ── Treffer und Auszeichnungen ───────────────────────────────────── -->
    <SolidColorBrush x:Key="SearchHighlightBackgroundBrush" Color="#5A4A15" />
    <SolidColorBrush x:Key="SearchHighlightForegroundBrush" Color="#F2E8C8" />
    <SolidColorBrush x:Key="TagBackgroundBrush"             Color="#213048" />
    <SolidColorBrush x:Key="TagForegroundBrush"             Color="#A8C0CC" />
    <SolidColorBrush x:Key="TagBorderBrush"                 Color="#3A4E66" />


    <!--
        Die Fläche des Aufklappmenüs kommt aus den Systemfarben: WPF zeichnet es in einem
        eigenen Fenster und fragt dort nicht den Style des Eintrags. Ohne diese Werte stand
        im dunklen Erscheinungsbild helle Schrift auf weißem Grund.
    -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#152030" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#152030" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#152030" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#2E3E50" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E4EDF2" />


    <!--
        Auch die Auswahl in Baum und Liste kommt aus den Systemfarben: Das mitgelieferte
        Muster zeichnet sie im Blau des Systems, nicht in der Farbe der Anwendung.
    -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#213048" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E4EDF2" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1A2535" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E4EDF2" />

</ResourceDictionary>
