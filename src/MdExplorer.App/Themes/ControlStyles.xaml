<!--
    Grundbelegung der Steuerelemente.

    Ohne diese Datei nützen die Farbbelegungen wenig: Ein Bedienelement, an dem niemand
    eine Farbe gesetzt hat, nimmt nicht die der Anwendung, sondern die Voreinstellung des
    Rahmenwerks: Weiß mit schwarzer Schrift. Im hellen Erscheinungsbild fällt das nicht
    auf, im dunklen bliebe die halbe Oberfläche hell stehen.

    Der Weg führt über das Fenster: Es setzt Fläche und Schriftfarbe, und alles darin
    erbt die Schriftfarbe. Ein pauschaler Style für jeden Textblock wäre der falsche Weg,
    er schlüge die Vererbung und färbte auch die Beschriftungen um, die absichtlich auf
    einer Primärfläche stehen.

    Ein Style ohne Schlüssel greift nur beim genau passenden Typ, und jedes Fenster der
    Anwendung ist ein abgeleiteter. Jedes verweist deshalb ausdrücklich auf den
    Fenster-Style (Style="{StaticResource {x:Type Window}}"); ein lokaler Style baut mit
    BasedOn auf dem der Anwendung auf, statt ihn zu ersetzen. Beides prüft StyleGuardTests.

    Alle Farben als DynamicResource, damit der Wechsel des Erscheinungsbilds zur Laufzeit
    ankommt. StaticResource würde den Wert einmal auflösen und dann stehen lassen.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:menus="clr-namespace:MdExplorer.App.Views.Menus"
                    xmlns:converters="clr-namespace:MdExplorer.App.Converters">

    <converters:EnumDisplayConverter x:Key="EnumDisplay" />

    <!-- ── Fenster ──────────────────────────────────────────────────────── -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <!-- ── Menü ─────────────────────────────────────────────────────────── -->
    <!--
        Dieser Style färbt nur die Leiste. Das Aufklappteil tragen die beiden Muster weiter
        unten; was ohne eigenes Muster aus den Systemfarben liest, stellen die Belegungen
        (Light.xaml/Dark.xaml) um, weil es mit dem Erscheinungsbild wechselt.
    -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource ToolBarBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!--
        Das Aufklappmenü zeichnet WPF in einem eigenen Fenster, und dessen Fläche kommt weder
        aus dem Style des Eintrags noch aus den Systemfarben; sie steht im mitgelieferten
        Muster fest. Im dunklen Erscheinungsbild stünde dort helle Schrift auf weißem Grund,
        und die Menüpunkte wären nicht zu lesen. Deshalb tragen beide Ebenen ein eigenes
        Muster, der Eintrag in der Leiste und der Eintrag im Aufklappteil.
    -->
    <ControlTemplate x:Key="MenuEntryTemplate" TargetType="MenuItem">
        <Border x:Name="Shape" Background="{DynamicResource SurfaceBrush}" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True" />
                <!-- Das Tastenkürzel tritt zurück, ohne zu verschwinden. -->
                <TextBlock Grid.Column="1"
                           Margin="16,0,0,0"
                           Text="{TemplateBinding InputGestureText}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        Der Titel in der Leiste bringt sein Aufklappteil selbst mit. Grund ist die
        Windows-Einstellung „Menüs rechtsbündig ausrichten": Steht sie an, hängt WPF das
        Aufklappteil an die rechte Kante des Titels, und bei „Datei" ganz links läuft es
        über den Fensterrand hinaus. Die Platzierung liegt deshalb in eigener Hand — linke
        Kante bündig zum Titel, direkt darunter (siehe MenuPopupPlacement).
    -->
    <ControlTemplate x:Key="MenuTitleTemplate" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Shape" Background="{TemplateBinding Background}" Padding="10,4">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </Border>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Custom"
                   CustomPopupPlacementCallback="{x:Static menus:MenuPopupPlacement.BelowLeftAligned}">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        Padding="0,4">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Shape" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        Ein Eintrag mit eigenem Untermenü (Rolle SubmenuHeader) bekommt bewusst kein eigenes
        Muster: Das Eintragsmuster hat kein Aufklappteil, das Untermenü ginge nie auf. Die
        Anwendung hat derzeit keine verschachtelten Menüs; wer eines anlegt, braucht ein
        Muster mit Aufklappteil nach rechts, nach dem Vorbild von MenuTitleTemplate.
    -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource MenuTitleTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource MenuEntryTemplate}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>

    <!--
        Im Menü greift ein eigener Schlüssel; ohne ihn bliebe der Trenner eine namenlose
        Lücke zwischen zwei Einträgen statt einer Linie.
    -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Leisten ──────────────────────────────────────────────────────── -->
    <Style TargetType="ToolBar">
        <Setter Property="Background" Value="{DynamicResource ToolBarBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="ToolBarTray">
        <Setter Property="Background" Value="{DynamicResource ToolBarBackgroundBrush}" />
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource StatusBarBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource StatusBarForegroundBrush}" />
    </Style>

    <!-- ── Register ─────────────────────────────────────────────────────── -->
    <!--
        Beide Register-Bausteine tragen ein eigenes Muster, und zwar aus einem Grund:
        Das mitgelieferte Muster von WPF zeichnet den gewählten Reiter und die Restfläche
        der Reiterleiste mit eigenen, festen Farben. Ein Setter für die Fläche läuft dort
        ins Leere. Im dunklen Erscheinungsbild stünde der gewählte Reiter weiß da, mit
        heller Schrift darauf, und rechts daneben ein weißer Streifen.

        Was man ersetzt, muss man vollständig ersetzen: Die Muster bringen deshalb
        Zustände, Fokusanzeige und Tastaturführung selbst mit.
    -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource ToolBarBackgroundBrush}">
                            <TabPanel IsItemsHost="True"
                                      Margin="4,4,4,0"
                                      Panel.ZIndex="1"
                                      KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,1,0,0"
                                KeyboardNavigation.TabNavigation="Local"
                                KeyboardNavigation.TabIndex="2">
                            <!--
                                Der Name ist vorgegeben: Unter ihm sucht der Automatisierungspartner
                                des Registers den Inhalt. Fehlt er, ist für Screenreader unter
                                keinem Register etwas vorhanden.
                            -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Shape"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="{StaticResource BadgeCornerRadius}"
                                Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <!--
                            Der gewählte Reiter trägt zusätzlich eine Kante am oberen Rand.
                            Damit ist er auch dann erkennbar, wenn jemand Farben schlecht
                            unterscheidet; die fette Schrift allein bliebe grenzwertig.
                        -->
                        <Border x:Name="ActiveEdge"
                                Height="2"
                                Margin="0,0,2,0"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AccentPrimaryBrush}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            <Setter TargetName="ActiveEdge" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </MultiTrigger>
                        <!-- Der neue Rahmen übernimmt die Fokusanzeige, die das ersetzte Muster mitbrachte. -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource InputBorderFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Listen und Bäume ─────────────────────────────────────────────── -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>

    <!--
        Die Auswahl ist nicht allein über die Fläche erkennbar: Sie trägt zusätzlich eine
        farbige Kante links. Wer Farben schlecht unterscheidet, sieht trotzdem, was gewählt ist.

        Mit eigenem Muster, weil das mitgelieferte die Auswahl aus den Systemfarben holt, und
        zwar als statischen Verweis, der beim Umschalten des Erscheinungsbilds nicht nachzieht.
        Der gewählte Eintrag bliebe sonst in der Farbe stehen, die beim Start galt.
    -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{StaticResource CompactPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Shape"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="{StaticResource CompactPadding}" />
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DividerBrush}" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="{StaticResource CompactPadding}" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Eingabe ──────────────────────────────────────────────────────── -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="Padding" Value="{StaticResource CompactPadding}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderFocusBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource InputBackgroundDisabledBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Das Auswahlfeld ist der hartnäckigste Fall: Sein mitgeliefertes Muster zeichnet Fläche,
        Rahmen, Pfeil und den ausgewählten Eintrag mit eigenen festen Farben. Im dunklen
        Erscheinungsbild stünde das Feld leer da, weil der Text schwarz auf dunklem Grund
        nicht zu sehen wäre. Das eigene Muster nimmt Fläche und Schrift der
        Anwendung und bringt Aufklappteil und Zustände selbst mit.
    -->
    <ControlTemplate x:Key="ComboBoxToggleTemplate" TargetType="ToggleButton">
        <Border Background="Transparent" BorderThickness="0">
            <Path x:Name="Arrow"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"
                  Data="M 0 0 L 4 4 L 8 0 Z"
                  Fill="{DynamicResource TextSecondaryBrush}" />
        </Border>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Padding" Value="{StaticResource CompactPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <!--
                        Der Pfeil hat eine eigene Spalte, damit ein langer Eintrag in einer
                        schmalen Spalte vor ihm endet. In derselben Zelle liefe der Text unter den
                        Pfeil, und der stünde als grauer Fleck auf den letzten Buchstaben.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Shape"
                                Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}" />
                        <ToggleButton Grid.ColumnSpan="2"
                                      Template="{StaticResource ComboBoxToggleTemplate}"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" />
                        <ContentPresenter Grid.Column="0"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Popup Grid.ColumnSpan="2"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               HorizontalOffset="0"
                               VerticalOffset="0"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource InputBorderFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource InputBackgroundDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="{StaticResource CompactPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Shape" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>

    <!-- ── Schaltflächen ────────────────────────────────────────────────── -->
    <!--
        Auch hier ein eigenes Muster, und aus demselben Grund wie bei den Registern: Das
        mitgelieferte Muster zeichnet den ruhenden und den abgeschalteten Zustand mit festen
        hellen Farben und schlägt dabei jeden Setter. Im dunklen Erscheinungsbild leuchteten
        sonst ausgerechnet die abgeschalteten Schaltflächen hell auf, während die bedienbaren
        daneben dunkel blieben; die Bedeutung wäre damit umgekehrt.
    -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shape"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                        </Trigger>
                        <!-- Der neue Rahmen übernimmt die Fokusanzeige des ersetzten Musters. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource InputBorderFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource ButtonBackgroundDisabledBrush}" />
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource ButtonBackgroundDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Der Umschalter braucht sein eigenes Muster aus demselben Grund wie die Schaltfläche:
        Das mitgelieferte zeichnet den eingeschalteten Zustand mit einer festen hellen Fläche
        und schlägt den Setter. Die Zeitraum-Chips stünden sonst hell da, mit heller Schrift
        darauf. Der eingeschaltete Zustand ist zusätzlich an der fetten Schrift erkennbar,
        nicht allein an der Farbe.
    -->
    <Style TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource CompactPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Shape"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource InputBorderFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource ButtonBackgroundDisabledBrush}" />
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource ButtonBackgroundDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Kopfleiste und Segmente ──────────────────────────────────────── -->
    <!--
        Symbolknöpfe der Kopfleiste: ohne Fläche und Rahmen, bis die Maus darauf steht oder die
        Tastatur sie erreicht. Das Muster kommt von den Knöpfen oben, damit Fokus und
        abgeschalteter Zustand dieselben bleiben. Den Namen für Screenreader und den Tooltip
        trägt jeder Knopf selbst; ein Symbol allein sagt nichts.
    -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource IconSizeIconButton}" />
        <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Derselbe Knopf als Schalter; eingeschaltet trägt er die Auswahlfläche samt Rand. -->
    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource IconSizeIconButton}" />
        <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!--
        Register als Segmentleiste statt als Reiter: eine Fläche, darin gleich breite Segmente,
        das gewählte hebt sich als helle Karte mit Rand und fetter Schrift ab. Nicht allein über
        die Farbe, damit es auch erkennbar bleibt, wer Farben schlecht unterscheidet. Nur das
        Hauptfenster nimmt diese Form; die Register der Einstellungen bleiben Reiter.
    -->
    <Style x:Key="SegmentTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="{StaticResource CompactPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Shape"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="{StaticResource HairlineBorderThickness}"
                            CornerRadius="{StaticResource BadgeCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <!-- Wird die Spalte sehr schmal, endet der Name mit Auslassung statt zu überlappen. -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Shape" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource InputBorderFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentedTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentTabItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Margin="8,8,8,4"
                                Padding="2"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="{StaticResource HairlineBorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                            <UniformGrid Rows="1"
                                         IsItemsHost="True"
                                         KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <!-- Der Name ist vorgegeben, siehe das Muster der Register oben. -->
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          Grid.Row="1"
                                          ContentSource="SelectedContent"
                                          KeyboardNavigation.TabNavigation="Local"
                                          KeyboardNavigation.TabIndex="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Übriges ──────────────────────────────────────────────────────── -->
    <!--
        Auswahlfeld über die Werte einer Aufzählung. Ohne eigene Vorlage stünde der Bezeichner aus
        dem Code in der Liste („NearStemSynonyms"), und der Screenreader läse ihn ebenso vor.
    -->
    <Style x:Key="EnumComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Converter={StaticResource EnumDisplay}}" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Steht an Stelle einer Browserfläche, die nicht starten konnte, meist weil die
        WebView2-Laufzeit fehlt. Ohne ihn bliebe die Fläche leer, und der Grund stünde nur im
        Protokoll.
    -->
    <Style x:Key="BrowserUnavailableHintStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="24" />
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource SplitterBrush}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>

    <!--
        Der Aufklapp-Bereich holt die Farbe seiner Kopfzeile ebenfalls aus dem mitgelieferten
        Muster; im dunklen Erscheinungsbild wäre die Beschriftung dort kaum vom Grund zu
        unterscheiden. Der Pfeil dreht sich beim Aufklappen; der Zustand ist also nicht
        allein an der Farbe erkennbar.
    -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="ContentRow" Height="0" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="HeaderButton"
                                          Grid.Row="0"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          HorizontalContentAlignment="Left"
                                          Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="Arrow"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          Data="M 0 0 L 4 4 L 0 8 Z"
                                          Fill="{DynamicResource TextSecondaryBrush}" />
                                    <ContentPresenter ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True" />
                                </StackPanel>
                            </ToggleButton>
                            <ContentPresenter Grid.Row="1" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentRow" Property="Height" Value="Auto" />
                            <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 8 0 L 4 4 Z" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Der Kurzhinweis erscheint in einem eigenen Fenster und bringt die Farben des Systems
        mit, im dunklen Erscheinungsbild ein heller Kasten mitten in der Anwendung.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="Padding" Value="{StaticResource CompactPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource BadgeCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
        Verweise bringen als einziges Element eine eigene Farbe von WPF mit: ein festes
        Blau, das sich im dunklen Erscheinungsbild kaum vom Grund abhebt. Unterstrichen bleiben
        sie: Ein Verweis, der nur an der Farbe erkennbar ist, ist für manche keiner.
    -->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="TextDecorations" Value="Underline" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Abschnittsüberschrift der Linie: klein, gesperrt, gedämpft. -->
    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="{StaticResource StackGapS}" />
    </Style>

</ResourceDictionary>
