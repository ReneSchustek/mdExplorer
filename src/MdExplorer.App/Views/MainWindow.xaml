<Window x:Class="MdExplorer.App.Views.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        xmlns:l="clr-namespace:MdExplorer.App.Localization"
        xmlns:vm="clr-namespace:MdExplorer.App.ViewModels"
        xmlns:panels="clr-namespace:MdExplorer.App.Views.Panels"
        Title="{Binding Title}"
        Width="1280"
        Height="800"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing"
        Closed="OnClosed"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <DockPanel LastChildFill="True">
        <!--
            Kopfleiste statt Menüleiste: links die Marke, rechts die Werkzeuge als Symbolknöpfe,
            unten eine Haarlinie, keine Schatten. Jeder Knopf trägt Tooltip und Namen; die
            Tastenkürzel stehen im Tooltip und gelten weiter.
        -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,4,8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Logo.png"
                           Width="20"
                           Height="20"
                           Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Title}"
                               FontSize="{StaticResource FontSizeSubtitle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource IconToggleButtonStyle}"
                                  Content="{StaticResource GlyphSidePanel}"
                                  IsChecked="{Binding IsTagCloudShown, Mode=TwoWay}"
                                  ToolTip="{l:Loc Main_Toolbar_TagCloud}"
                                  AutomationProperties.Name="{l:Loc Main_Toolbar_TagCloud}" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="{StaticResource GlyphTag}"
                            Click="OnTagManagementClick"
                            ToolTip="{l:Loc Main_Toolbar_TagManagement}"
                            AutomationProperties.Name="{l:Loc Main_Toolbar_TagManagement}" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="{StaticResource GlyphGraph}"
                            Click="OnGraphClick"
                            ToolTip="{l:Loc Main_Toolbar_Graph}"
                            AutomationProperties.Name="{l:Loc Main_Toolbar_Graph}" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="{StaticResource GlyphList}"
                            Click="OnLogViewerClick"
                            ToolTip="{l:Loc Main_Toolbar_Logs}"
                            AutomationProperties.Name="{l:Loc Main_Toolbar_Logs}" />
                    <Border Width="1"
                            Height="20"
                            Margin="6,0,4,0"
                            Background="{DynamicResource DividerBrush}" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="{StaticResource GlyphSettings}"
                            Click="OnSettingsClick"
                            ToolTip="{l:Loc Main_Toolbar_Settings}"
                            AutomationProperties.Name="{l:Loc Main_Toolbar_Settings}" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="{StaticResource GlyphHelp}"
                            Click="OnHelpClick"
                            ToolTip="{l:Loc Main_Toolbar_Manual}"
                            AutomationProperties.Name="{l:Loc Main_Toolbar_Manual}" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            Content="{StaticResource GlyphInfo}"
                            Click="OnAboutClick"
                            ToolTip="{l:Loc Main_Toolbar_About}"
                            AutomationProperties.Name="{l:Loc Main_Toolbar_About}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource NoticeWarningBackgroundBrush}"
                BorderBrush="{DynamicResource NoticeWarningBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6"
                Visibility="{Binding UpdateBanner.IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="{l:Loc Main_Update_NewVersion}" />
                    <Run Text="{Binding UpdateBanner.UpdateVersion, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{l:Loc Main_Update_Available}" />
                    <Hyperlink NavigateUri="{Binding UpdateBanner.UpdateReleaseUrl, Mode=OneWay}"
                               RequestNavigate="OnUpdateLinkRequestNavigate"><Run Text="{l:Loc Main_Update_OpenRelease}" /></Hyperlink>
                </TextBlock>
                <Button Grid.Column="1"
                        Content="✕"
                        Width="24"
                        Height="24"
                        Margin="8,0,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="{l:Loc Main_Update_Dismiss_ToolTip}"
                        AutomationProperties.Name="{l:Loc Main_Update_Dismiss_ToolTip}"
                        Command="{Binding UpdateBanner.DismissCommand}" />
            </Grid>
        </Border>
        <!--
            Schlanke Infoleiste: Schrift in Bildunterschriftgröße, gedämpft. Indexstand und Pfad
            kürzen mit Auslassung statt über den Rand zu laufen; der volle Pfad steht im Tooltip.
        -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,2"
                TextElement.FontSize="{StaticResource FontSizeCaption}"
                TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MaxWidth="360" />
                </Grid.ColumnDefinitions>
                <!--
                    Ein Knopf, keine bloße Form: per Tastatur erreichbar, für Screenreader mit
                    Rolle und Namen. Der Zustand steht zusätzlich als Wort daneben; die Farbe
                    allein trüge ihn für Farbenblinde nicht.
                -->
                <Button Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="2,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnHealthIndicatorClick"
                        ToolTip="{Binding StatusBar.HealthDetail, Mode=OneWay}"
                        AutomationProperties.Name="{Binding StatusBar.HealthDetail, Mode=OneWay}"
                        AutomationProperties.LiveSetting="Polite">
                    <StackPanel Orientation="Horizontal">
                <Ellipse Width="12"
                         Height="12"
                         VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource StateSuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusBar.Health}" Value="Warning">
                                    <Setter Property="Fill" Value="{DynamicResource StateWarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusBar.Health}" Value="Error">
                                    <Setter Property="Fill" Value="{DynamicResource StateErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                        <TextBlock Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusBar.Health, Converter={StaticResource EnumDisplay}}" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Run Text="{l:Loc Main_IndexedFiles_Label}" />
                    <Run Text="{Binding StatusBar.IndexedFileCount, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding StatusBar.LastIndexerProgress, Mode=OneWay, StringFormat={l:Loc Main_Status_LastProgress_Format}, TargetNullValue={l:Loc Main_Status_LastProgress_None}}" />
                <TextBlock Grid.Column="3"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding StorageLocation, Mode=OneWay}"
                           ToolTip="{Binding StorageLocation, Mode=OneWay}" />
            </Grid>
        </Border>
        <Grid x:Name="ColumnsGrid" SizeChanged="OnColumnsSizeChanged">
            <Grid.ColumnDefinitions>
                <!-- Mindestbreite für drei Segmente nebeneinander, ohne dass ein Name gekürzt wird. -->
                <ColumnDefinition x:Name="FolderColumn" MinWidth="240" />
                <ColumnDefinition x:Name="FolderSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="PreviewColumn" MinWidth="320" />
                <ColumnDefinition x:Name="TagCloudSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="TagCloudColumn" Width="260" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0"
                        x:Name="LeftTabs"
                        Style="{StaticResource SegmentedTabControlStyle}"
                        SelectedIndex="{Binding LeftTabIndex, Mode=TwoWay}"
                        SelectionChanged="OnLeftTabsSelectionChanged">
                <TabItem Header="{l:Loc Main_Tab_Folders}">
                    <panels:FolderTreePanel DataContext="{Binding FolderTree}" />
                </TabItem>
                <TabItem Header="{l:Loc Main_Tab_AllFiles}" x:Name="AllFilesTabItem">
                    <ContentControl x:Name="AllFilesHost" DataContext="{Binding AllFiles}" />
                </TabItem>
                <TabItem Header="{l:Loc Main_Tab_Search}" x:Name="SearchTabItem">
                    <panels:SearchPanel x:Name="SearchPanelControl" DataContext="{Binding Search}" />
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}" DragCompleted="OnFolderSplitterDragCompleted" />
            <ContentControl x:Name="DocumentHost" Grid.Column="2" DataContext="{Binding DocumentPanel}" />
            <GridSplitter x:Name="TagCloudSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}" DragCompleted="OnFolderSplitterDragCompleted" />
            <ContentControl x:Name="TagCloudHost" Grid.Column="4" DataContext="{Binding TagCloud}" />
        </Grid>
    </DockPanel>
</Window>
