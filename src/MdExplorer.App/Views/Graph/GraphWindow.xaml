<Window x:Class="MdExplorer.App.Views.Graph.GraphWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        xmlns:l="clr-namespace:MdExplorer.App.Localization"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:MdExplorer.App.ViewModels.Graph"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{l:Loc Graph_Title}"
        Width="1000"
        Height="700"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance Type=vm:GraphViewModel}">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label x:Name="PathPrefixLabel"
                       Grid.Column="0"
                       Content="{l:Loc Graph_PathPrefix_Label}"
                       Target="{Binding ElementName=PathPrefixInput}"
                       VerticalAlignment="Center"
                       Padding="0"
                       Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         x:Name="PathPrefixInput"
                         AutomationProperties.LabeledBy="{Binding ElementName=PathPrefixLabel}"
                         Text="{Binding PathPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         Padding="4,2"
                         ToolTip="{l:Loc Graph_PathPrefix_ToolTip}" />
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock>
                        <Run Text="{l:Loc Graph_Nodes_Label}" />
                        <Run Text="{Binding NodeCount, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{l:Loc Graph_Of}" />
                        <Run Text="{Binding OriginalNodeCount, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Margin="16,0,0,0">
                        <Run Text="{l:Loc Graph_Edges_Label}" />
                        <Run Text="{Binding EdgeCount, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{l:Loc Graph_Of}" />
                        <Run Text="{Binding OriginalEdgeCount, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{l:Loc Action_Reload}"
                        Command="{Binding RefreshCommand}"
                        Padding="10,2" />
            </Grid>
        </Border>
        <Grid>
            <wv2:WebView2 x:Name="GraphView" />
            <TextBlock x:Name="UnavailableHint"
                       Text="{l:Loc Browser_Unavailable}"
                       Visibility="Collapsed"
                       Style="{StaticResource BrowserUnavailableHintStyle}" />
            <Border Background="{DynamicResource SurfaceBrush}"
                    Opacity="0.92"
                    Padding="24"
                    CornerRadius="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    MaxWidth="520">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NodeCount}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,8"
                               Text="{l:Loc Graph_Empty_Title}" />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{l:Loc Graph_Empty_Hint}" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
