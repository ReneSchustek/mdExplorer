<UserControl x:Class="MdExplorer.App.Views.Settings.IndexingTab"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MdExplorer.App.Localization"
             xmlns:vm="clr-namespace:MdExplorer.App.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:IndexingTabViewModel}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{l:Loc Settings_Indexing_Roots_Heading}" FontWeight="SemiBold" Margin="0,0,0,4" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Roots}"
                     SelectedItem="{Binding SelectedRoot, Mode=TwoWay}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <Button Content="{l:Loc Settings_Indexing_AddRoot}" Command="{Binding AddRootCommand}" Margin="0,0,0,4" Padding="6,2" />
                <Button Content="{l:Loc Action_Remove}" Command="{Binding RemoveRootCommand}" Padding="6,2" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ExclusionsLabel" Grid.Row="2" Text="{l:Loc Settings_Indexing_Exclusions_Heading}" FontWeight="SemiBold" Margin="0,12,0,4" />
        <Grid Grid.Row="3" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" AutomationProperties.LabeledBy="{Binding ElementName=ExclusionsLabel}" Text="{Binding NewExclusionPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    Content="{l:Loc Action_Add}"
                    Command="{Binding AddExclusionCommand}"
                    Margin="6,0,0,0"
                    Padding="6,2" />
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding ExclusionPatterns}"
                     SelectedItem="{Binding SelectedExclusion, Mode=TwoWay}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <Button Content="{l:Loc Action_Remove}" Command="{Binding RemoveExclusionCommand}" Padding="6,2" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <TextBlock Text="{l:Loc Settings_Indexing_Tagging_Heading}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <CheckBox Content="{l:Loc Settings_Indexing_InlineTags}"
                      IsChecked="{Binding AutoExtractHashtags, Mode=TwoWay}"
                      ToolTip="{l:Loc Settings_Indexing_InlineTags_ToolTip}" />
        </StackPanel>
    </Grid>
</UserControl>
