<UserControl x:Class="MdExplorer.App.Views.Settings.BehaviorTab"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MdExplorer.App.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BehaviorTabViewModel}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </Grid.Resources>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Such-Debounce (ms):" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="0" Grid.Column="1"
                 Text="{Binding SearchDebounceMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Indexer-Resync-Intervall (s, 0 = aus):" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding IndexerResyncIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8" />

        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                  Content="Beim Start nach Updates suchen"
                  IsChecked="{Binding CheckForUpdatesAtStartup, Mode=TwoWay}"
                  Margin="0,4,0,0" />

        <!-- Ab Werk aus, und das ist eine Zusage: Die Anwendung arbeitet ohne
             Internetverbindung. Ein Bild aus dem Netz ruft beim Anzeigen einen fremden
             Server auf und verrät ihm, wann welche Notiz geöffnet wurde. -->
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <CheckBox Content="Bilder aus dem Netz in der Vorschau laden"
                      IsChecked="{Binding LoadRemoteImagesInPreview, Mode=TwoWay}" />
            <TextBlock Text="Aus. Damit bleibt die Vorschau ohne Internetverbindung vollständig. Eingeschaltet werden auch Abzeichen und Bilder von fremden Servern geladen — die erfahren dann, wann Sie welche Notiz ansehen."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="24,2,0,0" />
        </StackPanel>

        <!-- Update-Abschnitt: Prüfen und Installieren. Bewusst zweistufig — installiert
             wird erst auf ausdrücklichen zweiten Klick. -->
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0"
                    DataContext="{Binding Update}">
            <Separator Margin="0,0,0,10" />
            <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <ProgressBar Height="6"
                         Margin="0,8,0,0"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         Visibility="{Binding IsProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Nach Updates suchen"
                        Command="{Binding CheckCommand}"
                        Padding="12,4" />
                <Button Content="Jetzt aktualisieren"
                        Command="{Binding InstallCommand}"
                        Padding="12,4"
                        Margin="8,0,0,0"
                        Visibility="{Binding IsInstallAvailable, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
