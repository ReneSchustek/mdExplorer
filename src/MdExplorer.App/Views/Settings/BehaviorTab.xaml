<UserControl x:Class="MdExplorer.App.Views.Settings.BehaviorTab"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MdExplorer.App.Localization"
             xmlns:vm="clr-namespace:MdExplorer.App.ViewModels.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BehaviorTabViewModel}">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="DebounceLabel" Grid.Row="0" Grid.Column="0" Text="{l:Loc Settings_Behavior_Debounce_Label}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="0" Grid.Column="1"
                 AutomationProperties.LabeledBy="{Binding ElementName=DebounceLabel}"
                 Text="{Binding SearchDebounceMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8" />

        <TextBlock x:Name="ResyncLabel" Grid.Row="1" Grid.Column="0" Text="{l:Loc Settings_Behavior_Resync_Label}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="1" Grid.Column="1"
                 AutomationProperties.LabeledBy="{Binding ElementName=ResyncLabel}"
                 Text="{Binding IndexerResyncIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8" />

        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                  Content="{l:Loc Settings_Behavior_CheckOnStartup}"
                  IsChecked="{Binding CheckForUpdatesAtStartup, Mode=TwoWay}"
                  Margin="0,4,0,0" />

        <!-- Ab Werk aus, und das ist eine Zusage: Die Anwendung arbeitet ohne
             Internetverbindung. Ein Bild aus dem Netz ruft beim Anzeigen einen fremden
             Server auf und verrät ihm, wann welche Notiz geöffnet wurde. -->
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <CheckBox Content="{l:Loc Settings_Behavior_RemoteImages}"
                      IsChecked="{Binding LoadRemoteImagesInPreview, Mode=TwoWay}" />
            <TextBlock Text="{l:Loc Settings_Behavior_RemoteImages_Hint}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="24,2,0,0" />
        </StackPanel>

        <!-- Update-Abschnitt: Prüfen und Installieren. Bewusst zweistufig: Installiert
             wird erst auf ausdrücklichen zweiten Klick. -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0"
                    DataContext="{Binding Update}">
            <Separator Margin="0,0,0,10" />
            <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <ProgressBar Height="6"
                         Margin="0,8,0,0"
                         Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         Visibility="{Binding IsProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="{l:Loc Settings_Behavior_CheckNow}"
                        Command="{Binding CheckCommand}"
                        Padding="12,4" />
                <Button Content="{l:Loc Settings_Behavior_InstallNow}"
                        Command="{Binding InstallCommand}"
                        Padding="12,4"
                        Margin="8,0,0,0"
                        Visibility="{Binding IsInstallAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
