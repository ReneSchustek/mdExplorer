<UserControl x:Class="MdExplorer.App.Views.Panels.SearchPanel"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MdExplorer.App.Localization"
             xmlns:vm="clr-namespace:MdExplorer.App.ViewModels"
             xmlns:controls="clr-namespace:MdExplorer.App.Controls"
             xmlns:conv="clr-namespace:MdExplorer.App.Converters"
             xmlns:models="clr-namespace:MdExplorer.Search.Models;assembly=MdExplorer.Search"
             d:DataContext="{d:DesignInstance Type=vm:SearchViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:HighlightToInlinesConverter x:Key="HighlightConverter" />
        <x:Array x:Key="SearchModes" Type="{x:Type models:SearchMode}">
            <models:SearchMode>Fts5</models:SearchMode>
            <models:SearchMode>Regex</models:SearchMode>
        </x:Array>
        <x:Array x:Key="SimilarityModes" Type="{x:Type models:SimilarityMode}">
            <models:SimilarityMode>None</models:SimilarityMode>
            <models:SimilarityMode>Stemmed</models:SimilarityMode>
            <models:SimilarityMode>NearStem</models:SimilarityMode>
            <models:SimilarityMode>NearStemSynonyms</models:SimilarityMode>
        </x:Array>
    </UserControl.Resources>
    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:SearchBox x:Name="QuerySearchBox"
                                Grid.Column="0"
                                Text="{Binding QueryText, Mode=TwoWay}"
                                Placeholder="{l:Loc Search_Placeholder}" />
            <ProgressBar Grid.Column="1"
                         Width="80"
                         Height="6"
                         IsIndeterminate="True"
                         Margin="8,0,0,0"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <!--
            Beide Auswahlen so breit wie ihr Eintrag; reicht die Spalte nicht, rutscht die
            Ähnlichkeit in die nächste Zeile. In festen Spaltenanteilen schnitt die schmale linke
            Spalte „Volltext“ ab, und „Regulärer Ausdruck“ passte gar nicht.
        -->
        <WrapPanel DockPanel.Dock="Top" Margin="8,0,8,4">
            <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                <TextBlock x:Name="ModeLabel" Text="{l:Loc Search_Mode_Label}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=ModeLabel}"
                          Style="{StaticResource EnumComboBoxStyle}"
                          ItemsSource="{StaticResource SearchModes}"
                          SelectedItem="{Binding Mode, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock x:Name="SimilarityLabel" Text="{l:Loc Search_Similarity_Label}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=SimilarityLabel}"
                          Style="{StaticResource EnumComboBoxStyle}"
                          ItemsSource="{StaticResource SimilarityModes}"
                          SelectedItem="{Binding Similarity, Mode=TwoWay}" />
            </StackPanel>
        </WrapPanel>
        <CheckBox DockPanel.Dock="Top"
                  Margin="8,0,8,8"
                  Content="{l:Loc Search_CurrentFolderOnly}"
                  ToolTip="{l:Loc Search_CurrentFolderOnly_ToolTip}"
                  IsChecked="{Binding ScopeToSelectedFolder, Mode=TwoWay}" />
        <!--
            Vier Lagen, die eine Trefferliste allein nicht auseinanderhält: noch nicht gesucht,
            gesucht und nichts gefunden, Suche gescheitert, oder Treffer. Die drei leeren Lagen
            brauchen verschiedene Sätze, sonst hält der Nutzer seinen Bestand für leer.
        -->
        <Grid>
            <ListBox ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <!-- Ohne Namen läse der Screenreader den Typ des ViewModels vor. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Path}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeCaption}" />
                            <ContentControl Content="{Binding Snippet, Converter={StaticResource HighlightConverter}}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <controls:EmptyState Headline="{l:Loc Search_Empty_Idle_Headline}"
                                 Hint="{l:Loc Search_Empty_Idle_Hint}"
                                 Visibility="{Binding ShowsNothingSearchedYet, Converter={StaticResource BoolToVisibility}}" />

            <controls:EmptyState Headline="{l:Loc Search_Empty_NoMatch_Headline}"
                                 Hint="{l:Loc Search_Empty_NoMatch_Hint}"
                                 ShowsReset="True"
                                 ResetCommand="{Binding ClearSearchCommand}"
                                 Visibility="{Binding ShowsNoMatches, Converter={StaticResource BoolToVisibility}}" />

            <controls:EmptyState Headline="{l:Loc Search_Empty_Failed_Headline}"
                                 Hint="{l:Loc Search_Empty_Failed_Hint}"
                                 ShowsReset="True"
                                 ResetLabel="{l:Loc Search_Reset}"
                                 ResetCommand="{Binding ClearSearchCommand}"
                                 Visibility="{Binding ShowsSearchFailure, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
