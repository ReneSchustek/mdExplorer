<UserControl x:Class="MdExplorer.App.Views.Panels.SearchPanel"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MdExplorer.App.ViewModels"
             xmlns:controls="clr-namespace:MdExplorer.App.Controls"
             xmlns:conv="clr-namespace:MdExplorer.App.Converters"
             xmlns:models="clr-namespace:MdExplorer.Search.Models;assembly=MdExplorer.Search"
             d:DataContext="{d:DesignInstance Type=vm:SearchViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:HighlightToInlinesConverter x:Key="HighlightConverter" />
        <x:Array x:Key="SearchModes" Type="{x:Type models:SearchMode}">
            <models:SearchMode>Fts5</models:SearchMode>
            <models:SearchMode>Regex</models:SearchMode>
        </x:Array>
        <x:Array x:Key="SimilarityModes" Type="{x:Type models:SimilarityMode}">
            <models:SimilarityMode>None</models:SimilarityMode>
            <models:SimilarityMode>Stemmed</models:SimilarityMode>
            <models:SimilarityMode>NearStem</models:SimilarityMode>
            <models:SimilarityMode>NearStemSynonyms</models:SimilarityMode>
        </x:Array>
    </UserControl.Resources>
    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:SearchBox x:Name="QuerySearchBox"
                                Grid.Column="0"
                                Text="{Binding QueryText, Mode=TwoWay}"
                                Placeholder="Volltext, tag: und path: durchsuchen" />
            <ProgressBar Grid.Column="1"
                         Width="80"
                         Height="6"
                         IsIndeterminate="True"
                         Margin="8,0,0,0"
                         Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <Grid DockPanel.Dock="Top" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Modus:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{StaticResource SearchModes}"
                      SelectedItem="{Binding Mode, Mode=TwoWay}" />
            <TextBlock Grid.Column="2" Text="Ähnlichkeit:" VerticalAlignment="Center" Margin="8,0,4,0" />
            <ComboBox Grid.Column="3"
                      ItemsSource="{StaticResource SimilarityModes}"
                      SelectedItem="{Binding Similarity, Mode=TwoWay}" />
        </Grid>
        <CheckBox DockPanel.Dock="Top"
                  Margin="8,0,8,8"
                  Content="Nur aktueller Ordner"
                  ToolTip="Beschränkt die Treffer auf den im Ordnerbaum gewählten Pfad. Ohne Haken wird über alle Wurzeln gesucht."
                  IsChecked="{Binding ScopeToSelectedFolder, Mode=TwoWay}" />
        <!--
            Drei Lagen, die eine Trefferliste allein nicht auseinanderhält: noch nicht gesucht,
            gesucht und nichts gefunden, oder Treffer. Die ersten beiden brauchen verschiedene
            Sätze — sonst hält der Nutzer seinen Bestand für leer.
        -->
        <Grid>
            <ListBox ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Path}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeCaption}" />
                            <ContentControl Content="{Binding Snippet, Converter={StaticResource HighlightConverter}}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <controls:EmptyState Headline="Noch nichts gesucht"
                                 Hint="Tippen Sie einen Begriff ein. Mehrere Wörter werden mit UND verknüpft; tag: und path: schränken auf Kennzeichnung und Pfad ein."
                                 Visibility="{Binding ShowsNothingSearchedYet, Converter={StaticResource BoolToVisibility}}" />

            <controls:EmptyState Headline="Nichts gefunden"
                                 Hint="Zu dieser Anfrage gibt es keinen Treffer. Ein kürzerer Begriff oder eine andere Ähnlichkeit hilft oft weiter."
                                 ShowsReset="True"
                                 ResetCommand="{Binding ClearSearchCommand}"
                                 Visibility="{Binding ShowsNoMatches, Converter={StaticResource BoolToVisibility}}" />

            <controls:EmptyState Headline="Die Suche ist gescheitert"
                                 Hint="Die Anfrage konnte nicht ausgeführt werden. Einzelheiten stehen im Protokoll unter Ansicht → Logs…."
                                 ShowsReset="True"
                                 ResetLabel="Anfrage zurücksetzen"
                                 ResetCommand="{Binding ClearSearchCommand}"
                                 Visibility="{Binding ShowsSearchFailure, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
