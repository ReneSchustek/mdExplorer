<UserControl x:Class="MdExplorer.App.Views.Panels.DocumentPanel"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MdExplorer.App.Localization"
             xmlns:vm="clr-namespace:MdExplorer.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DocumentPanelViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <DockPanel LastChildFill="True">
        <!--
            Mit eigener Fläche, nicht durchsichtig: Eine Leiste ohne Hintergrund zeigt, was
            zufällig dahinter liegt (hier der eingebettete Browser, der seine eigene weiße
            Grundfarbe mitbringt und sie über die Leiste zieht).
        -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ToolBarBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Column="0"
                              x:Name="ModeToggle"
                              Content="{l:Loc Document_EditToggle}"
                              Padding="8,2"
                              IsChecked="{Binding IsEditMode, Mode=TwoWay}"
                              ToolTip="{l:Loc Document_EditToggle_ToolTip}" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
                    <Button Margin="6,0,0,0"
                            Padding="8,2"
                            Content="{l:Loc Document_EnterEdit}"
                            Command="{Binding Editor.EnterEditModeCommand}"
                            Visibility="{Binding Editor.IsLocked, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{l:Loc Document_EnterEdit_ToolTip}" />
                    <Button Margin="6,0,0,0"
                            Padding="8,2"
                            Content="{l:Loc Document_ExitEdit}"
                            Command="{Binding Editor.ExitEditModeCommand}"
                            ToolTip="{l:Loc Document_ExitEdit_ToolTip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Editor.IsLocked}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Margin="6,0,0,0"
                            Padding="8,2"
                            Content="{l:Loc Document_Save}"
                            Command="{Binding SaveCommand}"
                            ToolTip="{l:Loc Document_Save_ToolTip}" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding Editor.StatusMessage, Mode=OneWay, FallbackValue=''}"
                           AutomationProperties.LiveSetting="Polite"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="TagsLabel" DockPanel.Dock="Left" VerticalAlignment="Center" Text="{l:Loc Document_Tags_Label}" Margin="0,0,6,0" FontWeight="SemiBold" />
                <TextBox DockPanel.Dock="Left"
                         AutomationProperties.LabeledBy="{Binding ElementName=TagsLabel}"
                         Width="120"
                         VerticalAlignment="Center"
                         Margin="0,0,4,0"
                         Text="{Binding Editor.TagInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{l:Loc Document_NewTag_ToolTip}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding Editor.AddTagCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button DockPanel.Dock="Left"
                        Content="+"
                        Padding="6,2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Command="{Binding Editor.AddTagCommand}"
                        ToolTip="{l:Loc Document_AddTag_ToolTip}"
                        AutomationProperties.Name="{l:Loc Document_AddTag_ToolTip}" />
                <ItemsControl ItemsSource="{Binding Editor.Tags}">
                    <!-- Ohne Namen hieße der Eintrag im Automatisierungsbaum nach seinem Datentyp. -->
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2"
                                    Padding="6,1"
                                    Background="{DynamicResource TagBackgroundBrush}"
                                    BorderBrush="{DynamicResource TagBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    <Button Margin="6,0,0,0"
                                            Padding="4,0"
                                            Content="x"
                                            FontSize="10"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.Editor.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{l:Loc Document_RemoveTag_ToolTip}"
                                            AutomationProperties.Name="{Binding StringFormat={l:Loc Document_RemoveTag_Name}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="FindBar"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="{DynamicResource ToolBarBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FindLabel" VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:Loc Document_Find_Label}" />
                    <TextBox x:Name="FindInput"
                             AutomationProperties.LabeledBy="{Binding ElementName=FindLabel}"
                             Width="220"
                             VerticalAlignment="Center"
                             KeyDown="OnFindInputKeyDown"
                             TextChanged="OnFindTextChanged" />
                    <Button Margin="6,0,0,0"
                            Padding="6,2"
                            Content="▼"
                            Click="OnFindNextClick"
                            ToolTip="{l:Loc Document_FindNext_ToolTip}"
                            AutomationProperties.Name="{l:Loc Document_FindNext_ToolTip}" />
                    <Button Margin="2,0,0,0"
                            Padding="6,2"
                            Content="▲"
                            Click="OnFindPreviousClick"
                            ToolTip="{l:Loc Document_FindPrevious_ToolTip}"
                            AutomationProperties.Name="{l:Loc Document_FindPrevious_ToolTip}" />
                    <TextBlock x:Name="FindStatus"
                               AutomationProperties.LiveSetting="Polite"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Margin="12,0,0,0"
                            Padding="6,2"
                            Content="x"
                            Click="OnFindCloseClick"
                            ToolTip="{l:Loc Document_FindClose_ToolTip}"
                            AutomationProperties.Name="{l:Loc Document_FindClose_ToolTip}" />
                </StackPanel>
            </Border>
            <!--
                Zusammenhänge unter dem Dokument: wohin es verweist, wer auf es verweist, wo
                es liegt und was es trägt. Jeder Eintrag ist ein Weg. Wer eine Zeile liest
                und danach doch suchen muss, hat nichts gewonnen.
            -->
            <Expander Grid.Row="2"
                      DataContext="{Binding Relations}"
                      Header="{l:Loc Relations_Header}"
                      MaxHeight="220"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource DividerBrush}"
                      BorderThickness="0,1,0,0"
                      Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
                <!--
                    Eigene Fläche, wie die Leiste darüber: Ohne sie scheint der eingebettete
                    Browser mit seiner weißen Grundfarbe durch, und die helle Schrift steht
                    auf Weiß.
                -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="8,4"
                              Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Relations_Loading}"
                                   Style="{StaticResource SectionHeadingStyle}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{l:Loc Relations_Empty}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding ShowsNothingRelated, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{l:Loc Relations_Failed}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding ShowsFailure, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Visibility="{Binding ShowsRelations, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{l:Loc Relations_Outgoing}"
                                       Style="{StaticResource SectionHeadingStyle}"
                                       Margin="0,0,0,2"
                                       Visibility="{Binding HasOutgoing, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Outgoing}">
                                <!-- Ohne Namen hieße der Eintrag im Automatisierungsbaum nach seinem Datentyp. -->
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Left"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0,1"
                                                Content="{Binding Title}"
                                                ToolTip="{Binding RelativePath}"
                                                Command="{Binding DataContext.OpenRelatedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Title, StringFormat={l:Loc Document_Open_Format}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{l:Loc Relations_Incoming}"
                                       Style="{StaticResource SectionHeadingStyle}"
                                       Margin="0,8,0,2"
                                       Visibility="{Binding HasIncoming, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Incoming}">
                                <!-- Ohne Namen hieße der Eintrag im Automatisierungsbaum nach seinem Datentyp. -->
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Left"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0,1"
                                                Content="{Binding Title}"
                                                ToolTip="{Binding RelativePath}"
                                                Command="{Binding DataContext.OpenRelatedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Title, StringFormat={l:Loc Document_Open_Format}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{l:Loc Relations_Folder}" Style="{StaticResource SectionHeadingStyle}" Margin="0,8,0,2" />
                            <Button HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0,1"
                                    Content="{Binding FolderPath}"
                                    Command="{Binding ShowFolderCommand}"
                                    ToolTip="{l:Loc Relations_ShowFolder_ToolTip}"
                                    AutomationProperties.Name="{l:Loc Relations_ShowFolder_Name}" />

                            <!--
                                Bearbeiten geschieht im Zusammenhang: Wer zum Umbenennen erst
                                in eine Verwaltungsseite wechseln muss, verliert genau den
                                Zusammenhang, den er vor sich hatte.
                            -->
                            <TextBlock Text="{l:Loc Relations_ThisFile}" Style="{StaticResource SectionHeadingStyle}" Margin="0,8,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="180"
                                         VerticalAlignment="Center"
                                         Text="{Binding FileActions.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{l:Loc Relations_NewName_ToolTip}"
                                         AutomationProperties.Name="{l:Loc Relations_NewName_Name}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding FileActions.RenameCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Margin="4,0,0,0"
                                        Content="{l:Loc Relations_Rename}"
                                        Command="{Binding FileActions.RenameCommand}"
                                        ToolTip="{l:Loc Relations_Rename_ToolTip}" />
                                <Button Margin="4,0,0,0"
                                        Content="{l:Loc Relations_Move}"
                                        Command="{Binding FileActions.MoveCommand}"
                                        ToolTip="{l:Loc Relations_Move_ToolTip}" />
                                <Button Margin="4,0,0,0"
                                        Content="{l:Loc Relations_Delete}"
                                        Command="{Binding FileActions.DeleteCommand}"
                                        ToolTip="{l:Loc Relations_Delete_ToolTip}" />
                            </StackPanel>
                            <TextBlock Text="{l:Loc Relations_NewName_Invalid}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding FileActions.ShowsInvalidName, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding FileActions.OperationMessage}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <TextBlock Text="{l:Loc Relations_Tags}" Style="{StaticResource SectionHeadingStyle}" Margin="0,8,0,2" />
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <!-- Ohne Namen hieße der Eintrag im Automatisierungsbaum nach seinem Datentyp. -->
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,4,2"
                                                Padding="4,1"
                                                Content="{Binding}"
                                                Background="{DynamicResource TagBackgroundBrush}"
                                                Foreground="{DynamicResource TagForegroundBrush}"
                                                BorderBrush="{DynamicResource TagBorderBrush}"
                                                BorderThickness="1"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                Command="{Binding DataContext.ShowTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding StringFormat={l:Loc Document_Tag_ToolTip}}"
                                                AutomationProperties.Name="{Binding StringFormat={l:Loc Document_Tag_Name}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Expander>

            <Grid Grid.Row="1">
                <ContentControl x:Name="PreviewHost"
                                Visibility="{Binding IsReadMode, Converter={StaticResource BoolToVisibility}}" />
                <TextBox x:Name="EditorTextBox"
                         AutomationProperties.Name="{l:Loc Document_Editor_Name}"
                         Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}"
                         FontFamily="Consolas, Courier New, monospace"
                         FontSize="13"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         IsReadOnly="{Binding Editor.IsLocked}"
                         Text="{Binding Editor.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
