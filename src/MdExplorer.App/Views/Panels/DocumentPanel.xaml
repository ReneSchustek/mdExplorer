<UserControl x:Class="MdExplorer.App.Views.Panels.DocumentPanel"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MdExplorer.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DocumentPanelViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel LastChildFill="True">
        <!--
            Mit eigener Fläche, nicht durchsichtig: Eine Leiste ohne Hintergrund zeigt, was
            zufällig dahinter liegt — hier der eingebettete Browser, der seine eigene weiße
            Grundfarbe mitbringt und sie über die Leiste zog.
        -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ToolBarBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Column="0"
                              x:Name="ModeToggle"
                              Content="Bearbeiten"
                              Padding="8,2"
                              IsChecked="{Binding IsEditMode, Mode=OneWay}"
                              Command="{Binding ToggleModeCommand}"
                              ToolTip="Lese-/Bearbeiten-Modus umschalten (Strg+E)" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                    <Button Margin="6,0,0,0"
                            Padding="8,2"
                            Content="✏️ Bearbeiten"
                            Command="{Binding Editor.EnterEditModeCommand}"
                            Visibility="{Binding Editor.IsLocked, Converter={StaticResource BoolToVis}}"
                            ToolTip="Bearbeiten-Modus aktivieren — danach können Änderungen gespeichert werden" />
                    <Button Margin="6,0,0,0"
                            Padding="8,2"
                            Content="👁 Anzeigen"
                            Command="{Binding Editor.ExitEditModeCommand}"
                            ToolTip="Zurück in den Anzeigen-Modus">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Editor.IsLocked}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Margin="6,0,0,0"
                            Padding="8,2"
                            Content="Speichern"
                            Command="{Binding SaveCommand}"
                            ToolTip="Änderungen speichern (Strg+S)" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding Editor.StatusMessage, Mode=OneWay, FallbackValue=''}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="Tags:" Margin="0,0,6,0" FontWeight="SemiBold" />
                <TextBox DockPanel.Dock="Left"
                         Width="120"
                         VerticalAlignment="Center"
                         Margin="0,0,4,0"
                         Text="{Binding Editor.TagInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Neuen Tag eingeben und 'Hinzufügen' drücken">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding Editor.AddTagCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button DockPanel.Dock="Left"
                        Content="+"
                        Padding="6,2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Command="{Binding Editor.AddTagCommand}"
                        ToolTip="Tag hinzufügen" />
                <ItemsControl ItemsSource="{Binding Editor.Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2"
                                    Padding="6,1"
                                    Background="{DynamicResource TagBackgroundBrush}"
                                    BorderBrush="{DynamicResource TagBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    <Button Margin="6,0,0,0"
                                            Padding="4,0"
                                            Content="x"
                                            FontSize="10"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.Editor.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Tag entfernen" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="FindBar"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="{DynamicResource ToolBarBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="Suchen:" />
                    <TextBox x:Name="FindInput"
                             Width="220"
                             VerticalAlignment="Center"
                             KeyDown="OnFindInputKeyDown"
                             TextChanged="OnFindTextChanged" />
                    <Button Margin="6,0,0,0"
                            Padding="6,2"
                            Content="▼"
                            Click="OnFindNextClick"
                            ToolTip="Nächster Treffer (Enter / F3)" />
                    <Button Margin="2,0,0,0"
                            Padding="6,2"
                            Content="▲"
                            Click="OnFindPreviousClick"
                            ToolTip="Vorheriger Treffer (Shift+Enter / Shift+F3)" />
                    <TextBlock x:Name="FindStatus"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Margin="12,0,0,0"
                            Padding="6,2"
                            Content="x"
                            Click="OnFindCloseClick"
                            ToolTip="Suche schließen (Esc)" />
                </StackPanel>
            </Border>
            <!--
                Zusammenhänge unter dem Dokument: wohin es verweist, wer auf es verweist, wo
                es liegt und was es trägt. Jeder Eintrag ist ein Weg — wer eine Zeile liest
                und danach doch suchen muss, hat nichts gewonnen.
            -->
            <Expander Grid.Row="2"
                      DataContext="{Binding Relations}"
                      Header="Zusammenhänge"
                      MaxHeight="220"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource DividerBrush}"
                      BorderThickness="0,1,0,0"
                      Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                <!--
                    Eigene Fläche, wie die Leiste darüber: Ohne sie scheint der eingebettete
                    Browser mit seiner weißen Grundfarbe durch, und die helle Schrift steht
                    auf Weiß.
                -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="8,4"
                              Background="{DynamicResource SurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Wird ermittelt …"
                                   Style="{StaticResource SectionHeadingStyle}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="Dieses Dokument steht für sich — keine Verweise, keine Kennzeichnungen."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding ShowsNothingRelated, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Visibility="{Binding ShowsRelations, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="VERWEIST AUF"
                                       Style="{StaticResource SectionHeadingStyle}"
                                       Margin="0,0,0,2"
                                       Visibility="{Binding HasOutgoing, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Outgoing}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Left"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0,1"
                                                Content="{Binding Title}"
                                                ToolTip="{Binding RelativePath}"
                                                Command="{Binding DataContext.OpenRelatedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Title, StringFormat='{}{0} öffnen'}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="VERWIESEN VON"
                                       Style="{StaticResource SectionHeadingStyle}"
                                       Margin="0,8,0,2"
                                       Visibility="{Binding HasIncoming, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Incoming}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Left"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0,1"
                                                Content="{Binding Title}"
                                                ToolTip="{Binding RelativePath}"
                                                Command="{Binding DataContext.OpenRelatedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Title, StringFormat='{}{0} öffnen'}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="ORDNER" Style="{StaticResource SectionHeadingStyle}" Margin="0,8,0,2" />
                            <Button HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0,1"
                                    Content="{Binding FolderPath}"
                                    Command="{Binding ShowFolderCommand}"
                                    ToolTip="Zeigt, was sonst noch in diesem Ordner liegt"
                                    AutomationProperties.Name="Ordner anzeigen" />

                            <!--
                                Bearbeiten geschieht im Zusammenhang: Wer zum Umbenennen erst
                                in eine Verwaltungsseite wechseln muss, verliert genau den
                                Zusammenhang, den er vor sich hatte.
                            -->
                            <TextBlock Text="DIESE DATEI" Style="{StaticResource SectionHeadingStyle}" Margin="0,8,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="180"
                                         VerticalAlignment="Center"
                                         Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Neuer Dateiname — die Erweiterung .md wird ergänzt"
                                         AutomationProperties.Name="Neuer Dateiname">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding RenameCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Margin="4,0,0,0"
                                        Content="Umbenennen"
                                        Command="{Binding RenameCommand}"
                                        ToolTip="Benennt die Datei um; der Ordner bleibt derselbe" />
                                <Button Margin="4,0,0,0"
                                        Content="Verschieben …"
                                        Command="{Binding MoveCommand}"
                                        ToolTip="Verschiebt die Datei in ein anderes Verzeichnis" />
                                <Button Margin="4,0,0,0"
                                        Content="Löschen …"
                                        Command="{Binding DeleteCommand}"
                                        ToolTip="Löscht die Datei — die Rückfrage nennt vorher die Folgen" />
                            </StackPanel>
                            <TextBlock Text="{Binding OperationMessage}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <TextBlock Text="KENNZEICHNUNGEN" Style="{StaticResource SectionHeadingStyle}" Margin="0,8,0,2" />
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,4,2"
                                                Padding="4,1"
                                                Content="{Binding}"
                                                Background="{DynamicResource TagBackgroundBrush}"
                                                Foreground="{DynamicResource TagForegroundBrush}"
                                                BorderBrush="{DynamicResource TagBorderBrush}"
                                                BorderThickness="1"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                Command="{Binding DataContext.ShowTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding StringFormat='Zeigt, was sonst noch {0} trägt'}"
                                                AutomationProperties.Name="{Binding StringFormat='Kennzeichnung {0} anzeigen'}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Expander>

            <Grid Grid.Row="1">
                <ContentControl x:Name="PreviewHost"
                                Visibility="{Binding IsReadMode, Converter={StaticResource BoolToVis}}" />
                <TextBox x:Name="EditorTextBox"
                         Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                         FontFamily="Consolas, Courier New, monospace"
                         FontSize="13"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         IsReadOnly="{Binding Editor.IsLocked}"
                         Text="{Binding Editor.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
