<Window x:Class="MdExplorer.App.Views.Help.HelpWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        xmlns:l="clr-namespace:MdExplorer.App.Localization"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:MdExplorer.App.ViewModels.Help"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{l:Loc Help_Title}"
        Width="980"
        Height="720"
        MinWidth="640"
        MinHeight="420"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        d:DataContext="{d:DesignInstance Type=vm:HelpViewModel}">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         VerticalContentAlignment="Center"
                         Padding="6,2"
                         AutomationProperties.Name="{l:Loc Help_Search_Name}"
                         TextChanged="OnSearchTextChanged" />
                <!-- Angesagt, sobald sich der Stand ändert: Wer nicht sieht, erfährt sonst nicht,
                     ob die Suche etwas gefunden hat. -->
                <TextBlock x:Name="HitLabel"
                           Grid.Column="1"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding HitSummary, Mode=OneWay}"
                           AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="2"
                        Content="◀"
                        Width="28"
                        Margin="0,0,4,0"
                        Click="OnPreviousHit"
                        ToolTip="{l:Loc Help_PreviousHit_ToolTip}"
                        AutomationProperties.Name="{l:Loc Help_PreviousHit_ToolTip}" />
                <Button Grid.Column="3"
                        Content="▶"
                        Width="28"
                        Click="OnNextHit"
                        ToolTip="{l:Loc Help_NextHit_ToolTip}"
                        AutomationProperties.Name="{l:Loc Help_NextHit_ToolTip}" />
            </Grid>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="TocList"
                     Grid.Column="0"
                     BorderThickness="0"
                     AutomationProperties.Name="{l:Loc Help_Toc_Name}"
                     SelectionChanged="OnTocSelectionChanged"
                     DisplayMemberPath="Title">
                <ListBox.ItemContainerStyle>
                    <!-- Ohne Namen läse der Screenreader den Datensatz samt Anker vor. -->
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource SplitterBrush}" />
            <wv2:WebView2 x:Name="HelpView" Grid.Column="2" />
            <TextBlock x:Name="UnavailableHint"
                       Grid.Column="2"
                       Text="{l:Loc Browser_Unavailable}"
                       Visibility="Collapsed"
                       Style="{StaticResource BrowserUnavailableHintStyle}" />
        </Grid>
    </DockPanel>
</Window>
