<Window x:Class="MdExplorer.App.Views.Help.AboutWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        xmlns:l="clr-namespace:MdExplorer.App.Localization"
        xmlns:vm="clr-namespace:MdExplorer.App.ViewModels.Help"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{l:Loc About_Title}"
        Width="520"
        Height="500"
        MinWidth="420"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}">
    <DockPanel LastChildFill="True" Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="MdExplorer" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="{l:Loc About_Version_Label}" />
                <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock Margin="0,2,0,12" Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="{l:Loc About_Build_Label}" />
                <Run Text="{Binding BuildDateDisplay, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{l:Loc About_Licenses_Heading}" FontWeight="SemiBold" Margin="0,8,0,4" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{l:Loc Action_Close}" Width="100" IsDefault="True" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
        <!-- Freiwilliger Spenden-Einstieg. Bleibt ausgeblendet, solange kein echter
             PayPal-Handle konfiguriert ist, damit nie ein toter Link erscheint. -->
        <StackPanel DockPanel.Dock="Bottom"
                    Margin="0,12,0,0"
                    Visibility="{Binding IsDonationVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Separator Margin="0,0,0,8" />
            <TextBlock Text="{l:Loc About_Donation_Text}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
            <Button Content="{l:Loc About_Donation_Button}"
                    HorizontalAlignment="Center"
                    Padding="12,4"
                    Margin="0,8,0,0"
                    AutomationProperties.Name="{l:Loc About_Donation_Name}"
                    Click="OnDonationClick" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Libraries}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:Loc About_Licenses_Package}" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="{l:Loc About_Licenses_License}" Binding="{Binding License}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
