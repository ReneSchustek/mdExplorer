<?xml version="1.0" encoding="utf-8"?>
<!--
  Dieselben Einstellungen wie installer/build-installer.ps1: eigenständig für win-x64, eine
  einzige Datei, Ausgabe nach publish/ im Repository. So liefert „Veröffentlichen“ in Visual
  Studio dasselbe, was der Installer verpackt.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
