<Window x:Class="MdExplorer.TagCloud.Views.TagManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        xmlns:l="clr-namespace:MdExplorer.TagCloud.Localization"
        xmlns:vm="clr-namespace:MdExplorer.TagCloud.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{l:Loc TagManagement_Title}"
        Width="720"
        Height="520"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=TagsGrid}"
        d:DataContext="{d:DesignInstance Type=vm:TagManagementViewModel}">
    <!--
        Die Ressourcen stehen vorn, nicht am Ende: WPF löst einen StaticResource-Verweis
        beim Lesen auf. Stünde der Block hinter dem Inhalt, wäre der Schlüssel an der
        Verwendungsstelle noch unbekannt, und das Fenster ließe sich gar nicht öffnen.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   FontWeight="SemiBold"
                   Text="{l:Loc TagManagement_Heading}"
                   Margin="0,0,0,8" />

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Erfolgs- und Fehlermeldungen sagt der Screenreader an, ohne den Fokus zu verschieben. -->
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Grid.Column="1"
                    Content="{l:Loc Action_Close}"
                    IsCancel="True"
                    Width="100"
                    Padding="6,2" />
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" LastChildFill="True">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label x:Name="ListLabel"
                           Grid.Column="0"
                           Padding="0"
                           Content="{l:Loc TagManagement_List_Heading}"
                           Target="{Binding ElementName=TagsGrid}"
                           VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="{l:Loc Action_Reload}"
                            Command="{Binding RefreshCommand}"
                            Padding="6,2" />
                </Grid>
                <DataGrid x:Name="TagsGrid"
                          AutomationProperties.LabeledBy="{Binding ElementName=ListLabel}"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          AlternatingRowBackground="{DynamicResource SurfaceElevatedBrush}"
                          BorderBrush="{DynamicResource DividerBrush}"
                          BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:Loc TagManagement_Column_Name}"
                                            Binding="{Binding Name}"
                                            Width="*" />
                        <DataGridTextColumn Header="{l:Loc TagManagement_Column_Slug}"
                                            Binding="{Binding Slug}"
                                            Width="*" />
                        <DataGridTextColumn Header="{l:Loc TagManagement_Column_Files}"
                                            Binding="{Binding Count}"
                                            Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Border Grid.Column="1" Width="1" Margin="12,0" Background="{DynamicResource DividerBrush}" />

            <StackPanel Grid.Column="2">
                <TextBlock Text="{l:Loc TagManagement_Action_Heading}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap"
                           Text="{l:Loc TagManagement_Hint}" />

                <Label x:Name="SelectedLabel"
                       Margin="0,12,0,4"
                       Padding="0"
                       Content="{l:Loc TagManagement_Selected}"
                       Target="{Binding ElementName=SelectedBox}" />
                <TextBox x:Name="SelectedBox"
                         IsReadOnly="True"
                         AutomationProperties.LabeledBy="{Binding ElementName=SelectedLabel}"
                         Text="{Binding SelectedItem.Name, Mode=OneWay, FallbackValue=''}" />

                <Label x:Name="NewNameLabel"
                       Margin="0,8,0,4"
                       Padding="0"
                       Content="{l:Loc TagManagement_NewName}"
                       Target="{Binding ElementName=NewNameBox}" />
                <TextBox x:Name="NewNameBox"
                         AutomationProperties.LabeledBy="{Binding ElementName=NewNameLabel}"
                         Text="{Binding NewTagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{l:Loc TagManagement_Rename}"
                            Command="{Binding RenameCommand}"
                            Margin="0,0,8,0"
                            Padding="10,4" />
                    <Button Content="{l:Loc TagManagement_Merge}"
                            Command="{Binding MergeCommand}"
                            Margin="0,0,8,0"
                            Padding="10,4" />
                    <Button Content="{l:Loc TagManagement_Delete}"
                            Command="{Binding DeleteCommand}"
                            Padding="10,4" />
                </StackPanel>

                <ProgressBar Height="6"
                             Margin="0,12,0,0"
                             IsIndeterminate="{Binding IsBusy}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
