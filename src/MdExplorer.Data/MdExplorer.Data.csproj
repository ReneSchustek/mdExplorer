<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MdExplorer.Data</RootNamespace>
    <AssemblyName>MdExplorer.Data</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MdExplorer.Core\MdExplorer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- Ausdrücklich gesetzt: Microsoft.Data.Sqlite 10.0.9 zieht sonst
         SQLitePCLRaw.lib.e_sqlite3 2.1.11 nach, die GHSA-2m69-gcr7-jv3q trägt
         (Schweregrad High). Das Bündel 3.0.3 bringt eine unbelastete Fassung mit.
         Beim Anheben von Microsoft.Data.Sqlite prüfen, ob der Eintrag noch nötig ist. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MdExplorer.Data.Tests" />
  </ItemGroup>

</Project>
