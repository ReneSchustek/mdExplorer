<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MdExplorer.Update</RootNamespace>
    <AssemblyName>MdExplorer.Update</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MdExplorer.Core\MdExplorer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <!--
    Öffentlicher Schlüssel für die Signaturprüfung der Update-Pakete. Fehlt die Datei, baut das
    Projekt trotzdem; die Anwendung installiert dann nur nicht selbst. Der Release-Workflow
    bricht ab, wenn der Schlüssel fehlt oder nicht zum privaten passt.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Signing\release-public-key.pem" LogicalName="MdExplorer.Update.release-public-key.pem" Condition="Exists('Signing\release-public-key.pem')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MdExplorer.Update.Tests" />
  </ItemGroup>

</Project>
